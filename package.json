{
  "name": "inhaler-reminder",
  "productName": "Inhaler Reminder",
  "version": "0.3.2",
  "description": "Asthma inhaler reminder for Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "test:config": "node scripts/config-test.js",
    "test:history": "node scripts/history-test.js",
    "test:scheduler": "node scripts/scheduler-test.js",
    "test:autostart": "node scripts/autostart-test.js",
    "test:inhaler": "node scripts/inhaler-test.js",
    "design-check": "node scripts/design-check.js",
    "test": "npm run test:config && npm run test:history && npm run test:scheduler && npm run test:autostart && npm run test:inhaler && npm run design-check",
    "render-icon": "electron scripts/render-icon.js",
    "capture": "electron . --capture-dir=qa",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "screenshots": "electron scripts/screenshots.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.inhalerreminder",
    "productName": "Inhaler Reminder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
